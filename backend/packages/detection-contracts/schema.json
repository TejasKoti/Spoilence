{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spoilence:rule-pack:1",
  "title": "Spoilence rule pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "topic",
    "version",
    "aliases",
    "characterAliases",
    "riskTerms",
    "safePhrases"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "topic": { "const": "gta-vi" },
    "version": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$" },
    "aliases": { "$ref": "#/$defs/terms" },
    "characterAliases": { "$ref": "#/$defs/terms" },
    "riskTerms": { "$ref": "#/$defs/terms" },
    "safePhrases": { "$ref": "#/$defs/terms" }
  },
  "$defs": {
    "terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    }
  }
}
